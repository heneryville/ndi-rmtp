+// in YUV420P, return an AVFrame owning its own buffers. Caller frees with
+// av_frame_free().
+static AVFrame *
+load_image_as_yuv420p(const char *path, int target_w, int target_h)
+{
+    AVFormatContext *fmt = NULL;
+    AVCodecContext *cdc = NULL;
+    AVFrame *decoded = NULL;
+    AVFrame *output = NULL;
+    struct SwsContext *sws = NULL;
+    AVPacket *pkt = NULL;
+    int vstream = -1;
+
+    if (avformat_open_input(&fmt, path, NULL, NULL) < 0) {
+        fprintf(stderr, "[sacrament] cannot open %s\n", path);
+        return NULL;
+    }
+    if (avformat_find_stream_info(fmt, NULL) < 0) goto cleanup;
+    for (unsigned i = 0; i < fmt->nb_streams; ++i) {
+        if (fmt->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_VIDEO) {
+            vstream = (int)i;
+            break;
+        }
+    }
+    if (vstream < 0) goto cleanup;
+
+    const AVCodec *codec = avcodec_find_decoder(fmt->streams[vstream]->codecpar->codec_id);
+    if (!codec) goto cleanup;
+    cdc = avcodec_alloc_context3(codec);
+    if (!cdc) goto cleanup;
+    if (avcodec_parameters_to_context(cdc, fmt->streams[vstream]->codecpar) < 0) goto cleanup;
+    if (avcodec_open2(cdc, codec, NULL) < 0) goto cleanup;
+
+    pkt = av_packet_alloc();
+    decoded = av_frame_alloc();
+    if (!pkt || !decoded) goto cleanup;
+
+    int got = 0;
+    while (av_read_frame(fmt, pkt) >= 0) {
+        if (pkt->stream_index == vstream) {
+            if (avcodec_send_packet(cdc, pkt) == 0 &&
+                avcodec_receive_frame(cdc, decoded) == 0) {
+                got = 1;
+                av_packet_unref(pkt);
+                break;
+            }
+        }
+        av_packet_unref(pkt);
+    }
+    if (!got) goto cleanup;
+
+    output = av_frame_alloc();
+    if (!output) goto cleanup;
+    output->format = AV_PIX_FMT_YUV420P;
+    output->width = target_w;
+    output->height = target_h;
+    if (av_frame_get_buffer(output, 32) < 0) { av_frame_free(&output); goto cleanup; }
+
+    sws = sws_getContext(
+        decoded->width, decoded->height, (enum AVPixelFormat)decoded->format,
+        target_w, target_h, AV_PIX_FMT_YUV420P,
+        SWS_BILINEAR, NULL, NULL, NULL);
+    if (!sws) { av_frame_free(&output); goto cleanup; }
+    sws_scale(sws,
+              (const uint8_t *const *)decoded->data, decoded->linesize,
+              0, decoded->height,
+              output->data, output->linesize);
+
+cleanup:
+    if (sws) sws_freeContext(sws);
+    if (decoded) av_frame_free(&decoded);
+    if (pkt) av_packet_free(&pkt);
+    if (cdc) avcodec_free_context(&cdc);
+    if (fmt) avformat_close_input(&fmt);
+    return output;
+}
